{
  "name": "puzzleforge-web",
  "version": "0.1.0",
  "description": "Teacher-facing web app for PuzzleForge — generate, preview, and download single puzzles.",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "archiver": "^7.0.1",
    "express": "^4.19.2",
    "puzzleforge-engine": "file:..",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.puzzleforge.desktop",
    "productName": "PuzzleForge",
    "files": [
      "electron/**/*",
      "server.js",
      "comfyui.js",
      "imagetools.js",
      "themegen.js",
      "workspace.js",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
